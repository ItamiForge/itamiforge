{
  "name": "itamiforge",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "generate:projects": "bun run scripts/generate-projects-index.ts",
    "prebuild": "bun run generate:projects",
    "build": "next build",
    "build:pages": "bun run build",
    "dev": "next dev",
    "preview:prod": "bun run build:pages && rm -rf .serve-prod && mkdir -p .serve-prod/itamiforge && cp -R out/. .serve-prod/itamiforge/ && touch .serve-prod/itamiforge/.nojekyll && printf '<!doctype html><meta http-equiv=\"refresh\" content=\"0; url=/itamiforge/\"><a href=\"/itamiforge/\">Open preview</a>' > .serve-prod/index.html && npx serve .serve-prod -l 3000",
    "serve:prod": "bun run preview:prod",
    "postinstall": "fumadocs-mdx",
    "compile": "tsc --noEmit",
    "lint": "biome check --write",
    "check": "bun run compile && bun run lint",
    "check:fix": "bun run compile && biome check --write --unsafe"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "animate-ui": "^0.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.0",
    "fumadocs-core": "16.6.1",
    "fumadocs-mdx": "14.2.7",
    "fumadocs-ui": "16.6.1",
    "lucide-react": "^0.563.0",
    "motion": "^12.34.5",
    "next": "16.1.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.6",
    "serve": "^14.2.5",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
