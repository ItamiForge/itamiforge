{
  "name": "itamiforge",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "generate:projects": "bun run scripts/generate-projects-index.ts",
    "generate:notes": "bun run scripts/generate-notes-index.ts",
    "prebuild": "bun run generate:projects && bun run generate:notes",
    "build": "next build",
    "dev": "next dev",
    "preview:prod": "bun run build && rm -rf .serve-prod && mkdir -p .serve-prod/itamiforge && cp -R out/. .serve-prod/itamiforge/ && touch .serve-prod/itamiforge/.nojekyll && printf '<!doctype html><meta http-equiv=\"refresh\" content=\"0; url=/itamiforge/\"><a href=\"/itamiforge/\">Open preview</a>' > .serve-prod/index.html && npx serve .serve-prod -l 3000",
    "postinstall": "fumadocs-mdx",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run build",
    "check:fix": "bun run lint:fix && bun run format && bun run typecheck && bun run build"
  },
  "dependencies": {
    "@nivo/line": "^0.99.0",
    "@orama/orama": "^3.1.18",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.34.0",
    "fumadocs-core": "16.6.1",
    "fumadocs-mdx": "14.2.7",
    "fumadocs-ui": "16.6.1",
    "lucide-react": "^0.563.0",
    "next": "16.2.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "zod": "^4"
  },
  "devDependencies": {
    "oxlint": "^0.16",
    "oxfmt": "^0.16",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.6",
    "serve": "^14.2.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  }
}
